{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hongjie:workflow-loop-event:1",
  "title": "Workflow Loop Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventVersion", "eventId", "loopId", "iteration", "actionSummary", "criterionUpdates", "progressFingerprint", "tokenDelta", "elapsedMinutes", "recordedAt", "control", "controlReason", "compactionHandoffRef"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventVersion": {"const": "1.0.0"},
    "eventId": {"type": "string", "minLength": 1},
    "loopId": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "actionSummary": {"type": "string", "minLength": 1},
    "criterionUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "status", "evidenceRefs", "validatorResultRef"],
        "properties": {
          "criterionId": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "PASS", "FAIL"]},
          "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[A-Za-z0-9._-]+$"}},
          "validatorResultRef": {"type": ["string", "null"]}
        }
      }
    },
    "progressFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tokenDelta": {"type": "integer", "minimum": 0},
    "elapsedMinutes": {"type": "integer", "minimum": 0},
    "recordedAt": {"type": "string", "format": "date-time"},
    "control": {"enum": ["CONTINUE", "BLOCK", "ESCALATE", "CANCEL"]},
    "controlReason": {"type": ["string", "null"]},
    "compactionHandoffRef": {"type": ["string", "null"]}
  }
}
